<?xml version="1.0" encoding="utf-8"?>
<!-- Tong quan theo AdminOverview cua web: 4 the so lieu, bieu do doanh thu, ti le dat phong -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/admin_overview_title"
                android:textSize="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_export"
                style="@style/Widget.AppBooking.Button.Excel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/admin_overview_export"
                app:icon="@drawable/ic_download" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_scan"
                style="@style/Widget.AppBooking.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/admin_overview_scan"
                app:icon="@drawable/ic_receipt" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_revenue"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/StatTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_overview_total_revenue" />

                    <TextView
                        android:id="@+id/text_revenue"
                        style="@style/StatValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/stat_revenue"
                        android:textSize="18sp"
                        app:drawableStartCompat="@drawable/ic_money"
                        app:drawableTint="@color/stat_revenue" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/StatTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_overview_total_bookings" />

                    <TextView
                        android:id="@+id/text_total_bookings"
                        style="@style/StatValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/link"
                        app:drawableStartCompat="@drawable/ic_receipt"
                        app:drawableTint="@color/link" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/StatTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_overview_pending_bookings" />

                    <TextView
                        android:id="@+id/text_pending_bookings"
                        style="@style/StatValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/stat_pending"
                        app:drawableStartCompat="@drawable/ic_schedule"
                        app:drawableTint="@color/stat_pending" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/StatTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_overview_pending_requests" />

                    <TextView
                        android:id="@+id/text_pending_requests"
                        style="@style/StatValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/stat_requests"
                        app:drawableStartCompat="@drawable/ic_person"
                        app:drawableTint="@color/stat_requests" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/CardBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_overview_revenue_chart"
                    android:textSize="16sp" />

                <com.nhom2.appbooking.ui.admin.RevenueChartView
                    android:id="@+id/chart_revenue"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <LinearLayout
                style="@style/CardBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_overview_booking_ratio"
                    android:textSize="16sp" />

                <com.nhom2.appbooking.ui.admin.DonutChartView
                    android:id="@+id/chart_ratio"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="12dp" />

                <LinearLayout
                    android:id="@+id/layout_legend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
