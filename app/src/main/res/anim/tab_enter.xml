<?xml version="1.0" encoding="utf-8"?>
<!-- Doi tab: noi dung moi hien dan va phong nhe (kieu "fade through" cua Material) -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/tab_transition_ms"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:shareInterpolator="true">
    <scale
        android:fromXScale="0.96"
        android:fromYScale="0.96"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1"
        android:toYScale="1" />
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1" />
</set>
